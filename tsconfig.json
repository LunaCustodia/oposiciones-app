{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "plugins": [{ "name": "workflow" }]
  },
  "include": ["server/**/*.ts", "src/**/*.ts", "tests/**/*.ts", "workflows/**/*.ts", "*.config.ts"]
}
